{
    "manifest_version": 3,
    "default_locale": "en",

    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "1.0",

    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },

    "background": {
        "scripts": [ "store-regions.js", "app-store-url.js", "background.js" ],
        "persistent": false,
        "type": "module"
    },

    "declarative_net_request": {
        "rule_resources": [{
            "id": "app_store_desktop_ua",
            "enabled": false,
            "path": "rules/app-store-desktop-ua.json"
        }]
    },

    "content_scripts": [{
        "js": [ "store-regions.js", "app-store-url.js", "content.js" ],
        "matches": [ "<all_urls>" ],
        "run_at": "document_start"
    }],

    "action": {
        "default_popup": "popup.html",
        "default_icon": "images/toolbar-icon.svg"
    },

    "permissions": [ "storage", "tabs", "webNavigation", "declarativeNetRequestWithHostAccess" ],

    "host_permissions": [ "*://apps.apple.com/*" ]
}
